Project travel_reservation {
  database_type: "PostgreSQL"
  Note: "Portfolio practice schema for relational database design and Abilympics Data Management and Processing preparation."
}

Table country {
  country_id integer [pk]
  country_code char(3) [not null, unique]
  country_name varchar(100) [not null, unique]

  Note: "Reference table for countries associated with members, travel destinations, and airlines."
}

Table member {
  member_id integer [pk]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  email varchar(150) [not null, unique]
  country_id integer [not null]
  membership_date date [not null]
  status varchar(20) [not null, note: "CHECK: ACTIVE or INACTIVE"]

  Indexes {
    country_id [name: "idx_member_country"]
  }

  Note: "Registered member/customer entity."
}

Table travel {
  travel_id integer [pk]
  destination varchar(120) [not null]
  country_id integer [not null]
  departure_date date [not null]
  return_date date [not null]
  price decimal(12,2) [not null, note: "CHECK: price >= 0; return_date >= departure_date"]

  Indexes {
    country_id [name: "idx_travel_country"]
  }

  Note: "Travel package/destination definition."
}

Table airline {
  airline_id integer [pk]
  airline_name varchar(120) [not null, unique]
  country_id integer [not null]

  Note: "Airline/operator reference entity."
}

Table schedule {
  schedule_id integer [pk]
  travel_id integer [not null]
  airline_id integer [not null]
  departure_time timestamp [not null]
  arrival_time timestamp [not null]
  gate varchar(20)

  Indexes {
    travel_id [name: "idx_schedule_travel"]
    airline_id [name: "idx_schedule_airline"]
  }

  Note: "Scheduled service for a travel package. CHECK: arrival_time > departure_time."
}

Table reservation {
  reservation_id integer [pk]
  member_id integer [not null]
  schedule_id integer [not null]
  reservation_date date [not null]
  status varchar(20) [not null, note: "CHECK: RESERVED, CANCELLED, or COMPLETED"]
  seat_number varchar(10)

  Indexes {
    member_id [name: "idx_reservation_member"]
    schedule_id [name: "idx_reservation_schedule"]
  }

  Note: "Member reservation against a scheduled service."
}

Ref: country.country_id < member.country_id
Ref: country.country_id < travel.country_id
Ref: country.country_id < airline.country_id
Ref: travel.travel_id < schedule.travel_id
Ref: airline.airline_id < schedule.airline_id
Ref: member.member_id < reservation.member_id
Ref: schedule.schedule_id < reservation.schedule_id
